# Copy to .env and fill in real values before running this service.
# Never commit .env — only .env.example.

NODE_ENV=development
PORT=3004

# Supabase Postgres connection. This service owns the "orders" schema only —
# no other service's tables live here, and this schema holds no cross-schema
# foreign keys (see prisma/schema.prisma). DIRECT_URL is only used by
# `prisma migrate`/`prisma db pull`, never at runtime.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=orders&pgbouncer=true
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=orders

# Bare origin (no trailing slash, path or query) — compared literally by
# OriginGuard against the Origin header on every mutating request, and used
# as the CORS allow-origin.
FRONTEND_URL=http://localhost:3000

SESSION_COOKIE_NAME=potala_session

SWAGGER_ENABLED=true
LOG_HTTP_BODY=false

# Single throttle group in this v1 — this service exposes neither /auth/*
# nor /internal/* routes of its own.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=60

# identity-service: required. This service has no local session table, so it
# cannot authenticate a single request without identity-service reachable.
IDENTITY_SERVICE_URL=http://localhost:3001
IDENTITY_SERVICE_API_KEY=CHANGE_ME_MUST_MATCH_IDENTITY_SERVICE_INTERNAL_API_KEY
IDENTITY_SERVICE_TIMEOUT_MS=5000

# catalog-service: required. This service has no local product/variant/stock
# data, so it cannot resolve or validate a single checkout line — let alone
# reserve stock — without catalog-service reachable. This value must match
# the INTERNAL_API_KEY configured on catalog-service itself (see that
# service's own .env.example), since it is sent as x-internal-api-key on
# every call this service makes to catalog-service's /internal/* routes.
CATALOG_SERVICE_URL=http://localhost:3003
CATALOG_SERVICE_API_KEY=CHANGE_ME_MUST_MATCH_CATALOG_SERVICE_INTERNAL_API_KEY
CATALOG_SERVICE_TIMEOUT_MS=5000

# sellers-service: required by the seller-orders read endpoints only
# (GET /seller/orders, GET /seller/orders/:id) — resolving which sellerId
# the authenticated user acts as means calling sellers-service's own
# GET /internal/sellers/membership/:userId. This value must match the
# INTERNAL_API_KEY configured on sellers-service itself.
SELLERS_SERVICE_URL=http://localhost:3002
SELLERS_SERVICE_API_KEY=CHANGE_ME_MUST_MATCH_SELLERS_SERVICE_INTERNAL_API_KEY
SELLERS_SERVICE_TIMEOUT_MS=5000
