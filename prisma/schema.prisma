generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

// Este serviço é o único dono do schema Postgres "orders" no banco Supabase
// compartilhado. Nenhuma outra tabela do marketplace vive aqui, e este schema
// não referencia tabelas de outros serviços por FK — customerId (Order) e
// sellerId/productId/variantId (SellerOrder/OrderItem) são referências
// soltas (UUID), nunca FK cross-schema. customerId é resolvido por
// SessionAuthGuard (rede, identity-service); productId/variantId/sellerId e
// os preços de cada linha são resolvidos e validados por
// CatalogServiceClient (rede, catalog-service) ANTES de qualquer linha ser
// gravada — ver docs/internal-api-contract.md.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["orders"]
}

// ---------------------------------------------------------------------------
// Pedidos (checkout multi-vendedor)
// Nomes físicos em português via @map / @@map, como no monólito de origem.
// Modelos portados fielmente do schema.prisma do monólito
// (marketing-place-potala-backend-main) — o monólito já tinha o MODELO de
// dados pronto e revisado; o que não existia em lugar nenhum do sistema era
// o CÓDIGO de checkout (carrinho, cobrança, webhook) — ver README.md para o
// que este serviço decide e o que fica deliberadamente fora da v1.
// ---------------------------------------------------------------------------

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  CANCELLED
  FULFILLING
  COMPLETED

  @@schema("orders")
}

enum SellerOrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED

  @@schema("orders")
}

enum PaymentTransactionStatus {
  PENDING
  APPROVED
  FAILED
  CANCELLED

  @@schema("orders")
}

enum CouponDiscountType {
  PERCENT
  FIXED

  @@schema("orders")
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED

  @@schema("orders")
}

model Order {
  id            String      @id @default(uuid()) @db.Uuid
  /// Referência solta (UUID) a identity.usuarios — sem FK cross-schema.
  /// Resolvido por SessionAuthGuard (rede, identity-service), nunca entrada
  /// bruta de cliente.
  customerId    String      @map("cliente_id") @db.Uuid
  orderNumber   String      @unique @map("numero_pedido")
  status        OrderStatus @default(PENDING_PAYMENT)
  /// Money CHECKs: each money column >= 0. No formula tying total to subtotal+shipping-discount
  /// (future taxes/credits/adjustments must remain possible).
  subtotalCents Int         @map("subtotal_centavos")
  /// v1 não calcula frete — sempre 0. Ver README.md.
  shippingCents Int         @default(0) @map("frete_centavos")
  discountCents Int         @default(0) @map("desconto_centavos")
  totalCents    Int         @map("total_centavos")
  createdAt     DateTime    @default(now()) @map("criado_em")
  updatedAt     DateTime    @updatedAt @map("atualizado_em")

  shippingAddress     OrderShippingAddress?
  sellerOrders        SellerOrder[]
  paymentTransactions PaymentTransaction[]

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@map("pedidos")
  @@schema("orders")
}

/// Snapshot of the delivery address at checkout time. Independent of any address book.
model OrderShippingAddress {
  id           String  @id @default(uuid()) @db.Uuid
  orderId      String  @unique @map("pedido_id") @db.Uuid
  recipient    String  @map("destinatario")
  street       String  @map("logradouro")
  number       String  @map("numero")
  complement   String? @map("complemento")
  neighborhood String  @map("bairro")
  city         String  @map("cidade")
  state        String  @map("estado")
  postalCode   String  @map("cep")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("enderecos_entrega_pedido")
  @@schema("orders")
}

model SellerOrder {
  id              String            @id @default(uuid()) @db.Uuid
  orderId         String            @map("pedido_id") @db.Uuid
  /// Referência solta (UUID) a sellers.vendedores — sem FK cross-schema.
  /// Resolvido por CatalogServiceClient.resolveProductVariants (rede,
  /// catalog-service, que por sua vez é o dono autoritativo de
  /// Product.sellerId) — nunca entrada bruta de cliente.
  sellerId        String            @map("vendedor_id") @db.Uuid
  status          SellerOrderStatus @default(PENDING)
  /// Money CHECKs: each column >= 0. No rigid sellerNet = subtotal + shipping - commission.
  subtotalCents   Int               @map("subtotal_centavos")
  /// v1 não calcula frete nem comissão — sempre 0. Ver README.md.
  shippingCents   Int               @default(0) @map("frete_centavos")
  commissionCents Int               @default(0) @map("comissao_centavos")
  sellerNetCents  Int               @default(0) @map("liquido_vendedor_centavos")
  createdAt       DateTime          @default(now()) @map("criado_em")
  updatedAt       DateTime          @updatedAt @map("atualizado_em")

  order Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items OrderItem[]

  @@unique([orderId, sellerId])
  @@index([orderId])
  @@index([sellerId])
  @@index([status])
  @@map("pedidos_vendedor")
  @@schema("orders")
}

model OrderItem {
  id             String  @id @default(uuid()) @db.Uuid
  sellerOrderId  String  @map("pedido_vendedor_id") @db.Uuid
  /// Referências soltas (UUID) a catalog.produtos / catalog.variantes_produto
  /// — sem FK cross-schema. Ambas vêm de
  /// CatalogServiceClient.resolveProductVariants, nunca de entrada bruta de
  /// cliente (o cliente manda productId/variantId candidatos; o que fica
  /// gravado aqui é sempre o que catalog-service confirmou).
  productId      String  @map("produto_id") @db.Uuid
  variantId      String  @map("variante_id") @db.Uuid
  productTitle   String  @map("titulo_produto")
  sku            String
  /// Snapshot CHECKs: quantidade > 0, money >= 0. No formula lineTotal = qty * unitPrice
  /// (enforced in application code at write time; not re-derived by the database).
  quantity       Int     @map("quantidade")
  unitPriceCents Int     @map("preco_unitario_centavos")
  lineTotalCents Int     @map("total_linha_centavos")

  sellerOrder SellerOrder @relation(fields: [sellerOrderId], references: [id], onDelete: Cascade)
  review      Review?
  returnRequest Return?

  @@index([sellerOrderId])
  @@index([productId])
  @@map("itens_pedido")
  @@schema("orders")
}

/// Charge attempts only (PENDING / APPROVED / FAILED / CANCELLED). Never store PAN/CVV.
/// amountCents CHECK: valor_centavos > 0. Refunds must not use negative amounts; add a type
/// discriminator first (this model has no CHARGE vs REFUND).
/// Idempotency: @@unique([provider, providerRef]). PostgreSQL treats NULL providerRef as distinct,
/// so many (provider, NULL) rows are allowed; a second (provider, same-ref) is rejected.
/// Empty/whitespace-only provider and providerRef are forbidden (CHECK + BTRIM). Values are not
/// trimmed in the database; the application/gateway normalizes provider.
/// If providerRef is set, provider is required (CHECK).
///
/// v1 only ever writes provider = "mock" (MockPaymentGatewayAdapter — see
/// modules/payments). The column stays provider-agnostic on purpose so a
/// real gateway adapter can be swapped in later without a schema change.
model PaymentTransaction {
  id          String                   @id @default(uuid()) @db.Uuid
  orderId     String                   @map("pedido_id") @db.Uuid
  status      PaymentTransactionStatus @default(PENDING)
  amountCents Int                      @map("valor_centavos")
  provider    String?                  @map("provedor")
  providerRef String?                  @map("referencia_provedor")
  createdAt   DateTime                 @default(now()) @map("criado_em")
  updatedAt   DateTime                 @updatedAt @map("atualizado_em")

  order Order @relation(fields: [orderId], references: [id])

  @@unique([provider, providerRef], map: "transacoes_pagamento_provedor_referencia_provedor_key")
  @@index([orderId])
  @@index([status])
  @@map("transacoes_pagamento")
  @@schema("orders")
}

/// Fase B do roadmap pos-entrega (ver roadmap-mercado-livre.md, secao 6) --
/// avaliacao e reputacao. Uma avaliacao por item comprado, garantido pelo
/// @unique em orderItemId no proprio banco, nao so na aplicacao -- mesmo
/// estilo de integridade que PaymentTransaction.@@unique([provider,
/// providerRef]) acima. customerId/sellerId/productId sao snapshot no
/// momento da avaliacao, nunca FK cross-schema -- mesmo raciocinio de
/// OrderItem.productTitle/sku (linhas acima): sellerId vem de
/// SellerOrder.sellerId, productId vem de OrderItem.productId, ambos ja
/// resolvidos e validados por CatalogServiceClient no checkout, nunca
/// entrada bruta de cliente nesta escrita.
/// rating CHECK (1..5): adicionado a mao na migration em SQL cru, mesmo
/// padrao de todo CHECK numerico deste schema -- ver README.md.
model Review {
  id          String   @id @default(uuid()) @db.Uuid
  orderItemId String   @unique @map("item_pedido_id") @db.Uuid
  /// Referencia solta (UUID) a identity.usuarios -- quem comprou. Resolvido
  /// da sessao (SessionAuthGuard), nunca do corpo da requisicao.
  customerId  String   @map("cliente_id") @db.Uuid
  /// Snapshot de SellerOrder.sellerId no momento da avaliacao -- alimenta o
  /// agregado de reputacao do vendedor sem chamada cross-service.
  sellerId    String   @map("vendedor_id") @db.Uuid
  /// Snapshot de OrderItem.productId -- alimenta o agregado de nota do
  /// produto sem chamada cross-service.
  productId   String   @map("produto_id") @db.Uuid
  rating      Int      @map("nota")
  comment     String?  @map("comentario")
  createdAt   DateTime @default(now()) @map("criado_em")

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([sellerId])
  @@map("avaliacoes")
  @@schema("orders")
}

/// Cupons de desconto -- pedido de Arthur (urgente, ver
/// status-migracao-microservicos.md). Vive em orders-service, não em
/// sellers-service ou catalog-service, porque: (1) não tem sellerId --
/// mock confirma cupom é sempre marketplace-wide, nunca por loja
/// (ver src/features/admin/domain/types.ts no frontend, sem esse campo);
/// (2) Order já tinha uma coluna discountCents zerada à espera disso desde
/// a extração original do monólito ("v1 não calcula frete nem descontos --
/// sempre 0", orders.service.ts) -- este model é o que finalmente
/// preenche esse buraco, no mesmo serviço que já possui a coluna.
///
/// status (ativo/agendado/expirado/desativado, como no mock) NÃO é uma
/// coluna própria -- é derivado em runtime de enabled + comeca_em/termina_em
/// (CouponsService.deriveStatus), pelo mesmo motivo de Review não guardar
/// nota agregada: evita job de background pra manter um campo sincronizado
/// que dá pra calcular na leitura.
///
/// usageCount/totalDiscountCents são contadores atômicos incrementados no
/// checkout (mesma transação que cria o Order -- ver insertOrder em
/// orders.service.ts), não uma tabela de resgate à parte: mantém a
/// migration no menor escopo possível, mesmo raciocínio que já vinha sendo
/// aplicado nesta sessão (Admin: Clientes sem AuditLog). totalDiscountCents
/// substitui o "revenueCents" do mock -- aquele nome media receita
/// atribuída ao cupom, que não é computável sem juntar todo pedido que usou
/// o cupom; o que dá pra somar honestamente aqui é o desconto que o cupom
/// efetivamente concedeu.
///
/// channel do mock (all/site/app) foi removido -- não existe app do
/// marketplace, só o storefront web, então "canal" não distingue nada de
/// real hoje. Mesmo princípio de remover campo sem contrapartida real já
/// usado em CustomersView/SellersView.
model Coupon {
  id            String             @id @default(uuid()) @db.Uuid
  code          String             @unique @map("codigo")
  name          String             @map("nome")
  discountType  CouponDiscountType @map("tipo_desconto")
  /// Percentual (1-100) ou centavos (>0), a depender de discountType --
  /// CHECKs na migration, mesmo padrão de Review.rating.
  discountValue Int                @map("valor_desconto")
  /// Liga/desliga manual do admin (botão "Ativar"/"Desativar" no mock).
  /// Independente de comeca_em/termina_em -- um cupom pode estar dentro da
  /// janela de vigência e ainda assim desativado.
  enabled       Boolean            @default(true) @map("habilitado")
  startsAt      DateTime           @map("comeca_em")
  endsAt        DateTime           @map("termina_em")
  usageCount    Int                @default(0) @map("usos")
  totalDiscountCents Int           @default(0) @map("desconto_total_centavos")
  createdAt     DateTime           @default(now()) @map("criado_em")
  updatedAt     DateTime           @updatedAt @map("atualizado_em")

  @@index([enabled])
  @@map("cupons")
  @@schema("orders")
}

/// Devoluções -- pedido de Arthur ("vamos seguir em frente"), Fase E do
/// roadmap pós-entrega adiantada (ver roadmap-mercado-livre.md, seção 3:
/// "proteção ao comprador... o painel admin já tem a estrutura de
/// moderação... o admin como mediador"). Vive em orders-service, mesmo
/// raciocínio de Review: este serviço já é dono do OrderItem, e "só quem
/// comprou pode pedir devolução, uma vez por item" só é barato de garantir
/// referenciando o item de pedido diretamente, com @unique no próprio
/// banco -- não só na aplicação.
///
/// Elegibilidade (mesma de Review, mesmo motivo): SellerOrder com status
/// CONFIRMED, não "entregue" -- rastreio real (Fase D) não existe no
/// sistema, e nenhum endpoint hoje avança um SellerOrder além de
/// CONFIRMED, então "só pedido entregue" (como o mock antigo dizia)
/// nunca teria nenhum resultado elegível.
///
/// status é só REQUESTED/APPROVED/REJECTED -- de propósito SEM
/// reembolso automático: reembolsar de verdade exigiria (a) um
/// discriminador CHARGE/REFUND em PaymentTransaction, que hoje só
/// modela cobranças (ver comentário no model PaymentTransaction acima:
/// "Refunds must not use negative amounts; add a type discriminator
/// first"), e (b) repor estoque de volta em catalog-service, que hoje
/// não tem nenhum método pra isso (reserve/release/commitReservedStock
/// cobrem reserva e venda, não devolução pós-venda). Os dois exigiriam
/// migration/endpoint novo num SEGUNDO serviço -- escopo maior do que
/// cabe nesta rodada. O admin aprovando fica registrado como decisão
/// real; o reembolso em si é processado por fora do sistema por
/// enquanto (nota explícita na tela, mesmo espírito de honestidade já
/// aplicado ao resto do projeto -- não finge um reembolso automático
/// que não existe).
model Return {
  id          String       @id @default(uuid()) @db.Uuid
  orderItemId String       @unique @map("item_pedido_id") @db.Uuid
  /// Referência solta (UUID) a identity.usuarios -- quem comprou. Resolvido
  /// da sessão (SessionAuthGuard), nunca do corpo da requisição.
  customerId  String       @map("cliente_id") @db.Uuid
  /// Snapshot de SellerOrder.sellerId no momento do pedido de devolução.
  sellerId    String       @map("vendedor_id") @db.Uuid
  /// Snapshot de OrderItem.productId.
  productId   String       @map("produto_id") @db.Uuid
  reason      String       @map("motivo")
  description String?      @map("descricao")
  status      ReturnStatus @default(REQUESTED)
  createdAt   DateTime     @default(now()) @map("criado_em")
  updatedAt   DateTime     @updatedAt @map("atualizado_em")

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([sellerId])
  @@index([status])
  @@map("devolucoes")
  @@schema("orders")
}

/// Lista de desejos do cliente -- produto <-> cliente, sem relação com
/// pedido nenhum (diferente de Review/Coupon/Return acima, todos nascidos
/// de uma compra). Vive aqui mesmo assim, não em identity-service: segue a
/// mesma decisão já tomada na prática para avaliações e cupons (a análise
/// de arquitetura original previa "customers" crescendo dentro de
/// identity-service, mas o crescimento real -- avaliações, cupons -- caiu
/// todo em orders-service; endereços continua a única exceção genuína, por
/// ser puramente identidade/PII, sem nenhum link a produto).
model Favorite {
  id         String   @id @default(uuid()) @db.Uuid
  /// Referência solta (UUID) a identity.usuarios. Resolvido da sessão
  /// (SessionAuthGuard), nunca do corpo da requisição -- mesmo padrão de
  /// Review.customerId acima.
  customerId String   @map("cliente_id") @db.Uuid
  /// Referência solta (UUID) a catalog.produtos -- sem FK cross-schema,
  /// mesmo padrão de Review.productId. Ao contrário de Review (snapshot do
  /// produto no momento da compra), aqui NÃO guardamos nome/imagem/preço:
  /// a lista de favoritos deve refletir o produto como ele está agora, não
  /// como estava quando foi favoritado -- o frontend resolve cada item via
  /// GET /public/products/:id (catalog-service) na hora de exibir.
  productId  String   @map("produto_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("criado_em")

  @@unique([customerId, productId])
  @@index([customerId])
  @@map("favoritos")
  @@schema("orders")
}
