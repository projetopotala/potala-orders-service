generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

// Este serviço é o único dono do schema Postgres "orders" no banco Supabase
// compartilhado. Nenhuma outra tabela do marketplace vive aqui, e este schema
// não referencia tabelas de outros serviços por FK — customerId (Order) e
// sellerId/productId/variantId (SellerOrder/OrderItem) são referências
// soltas (UUID), nunca FK cross-schema. customerId é resolvido por
// SessionAuthGuard (rede, identity-service); productId/variantId/sellerId e
// os preços de cada linha são resolvidos e validados por
// CatalogServiceClient (rede, catalog-service) ANTES de qualquer linha ser
// gravada — ver docs/internal-api-contract.md.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["orders"]
}

// ---------------------------------------------------------------------------
// Pedidos (checkout multi-vendedor)
// Nomes físicos em português via @map / @@map, como no monólito de origem.
// Modelos portados fielmente do schema.prisma do monólito
// (marketing-place-potala-backend-main) — o monólito já tinha o MODELO de
// dados pronto e revisado; o que não existia em lugar nenhum do sistema era
// o CÓDIGO de checkout (carrinho, cobrança, webhook) — ver README.md para o
// que este serviço decide e o que fica deliberadamente fora da v1.
// ---------------------------------------------------------------------------

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  CANCELLED
  FULFILLING
  COMPLETED

  @@schema("orders")
}

enum SellerOrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED

  @@schema("orders")
}

enum PaymentTransactionStatus {
  PENDING
  APPROVED
  FAILED
  CANCELLED

  @@schema("orders")
}

enum CouponDiscountType {
  PERCENT
  FIXED

  @@schema("orders")
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  AWAITING_SHIPMENT
  SHIPPED
  RECEIVED
  UNDER_REVIEW
  COMPLETED
  CONTESTED
  CANCELLED

  @@schema("orders")
}

// ---------------------------------------------------------------------------
// Pos-venda -- fundacao (Fase E do roadmap, ver
// claude/plano-pos-venda-reclamacoes-devolucoes-disputas.md). Enums abaixo
// sao usados pelos models Claim/ClaimMessage/ClaimEvidence/ReturnShipment/
// Dispute/DisputeDecision mais abaixo no arquivo (apos o model Return).
// ---------------------------------------------------------------------------

/// Fase do ciclo de vida de uma Claim -- nunca o resultado (nao existe
/// "quem tinha razao" aqui; RESOLVED/CLOSED so descrevem que a conversa
/// terminou). Quando uma Claim escala a conflito formal, o resultado mora
/// em Dispute/DisputeDecision, nunca neste enum.
enum ClaimStatus {
  OPEN
  SELLER_RESPONSE_REQUIRED
  CUSTOMER_RESPONSE_REQUIRED
  RESOLVED
  ESCALATED
  CLOSED
  CANCELLED

  @@schema("orders")
}

/// Papel de quem escreveu uma ClaimMessage ou enviou uma ClaimEvidence --
/// mirror enum do Role de identity-service (ver
/// common/types/identity-enums.ts), mas como enum Prisma proprio deste
/// schema: Role ali e so TS, nunca Prisma, porque User vive no schema
/// identity, nao neste.
enum ClaimAuthorRole {
  CUSTOMER
  SELLER
  ADMIN

  @@schema("orders")
}

/// Fase do ciclo de vida de uma Dispute -- nunca quem ganhou (ver
/// DisputeOutcome). RESOLVED colapsa os tres valores originalmente
/// propostos (RESOLVED_CUSTOMER/RESOLVED_SELLER/RESOLVED_PARTIAL): fase
/// "resolvida" e resultado sao perguntas diferentes, e mistura-las
/// impediria registrar o resultado como seu proprio registro auditavel
/// (ver model DisputeDecision).
enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  WAITING_CUSTOMER
  WAITING_SELLER
  RESOLVED
  CLOSED

  @@schema("orders")
}

/// O resultado de uma disputa -- nullable em Dispute.outcome enquanto
/// aberta (ver model Dispute). Cada decisao registrada em DisputeDecision
/// carrega seu proprio outcome tambem, pra preservar historico mesmo se
/// uma decisao futura for revista.
enum DisputeOutcome {
  CUSTOMER_FAVORED
  SELLER_FAVORED
  PARTIAL
  NO_ACTION

  @@schema("orders")
}

/// Status de UMA tentativa de envio de devolucao -- nao da devolucao como
/// um todo (ver ReturnStatus, acima). Return -> ReturnShipment e 1:N de
/// proposito (nunca @@unique em returnId): uma tentativa perdida pelo
/// transportador pode ser seguida por uma nova tentativa sem precisar
/// remodelar nada depois -- "preparar para multiplas tentativas futuras
/// sem superengenharia" (pedido original, item 9). Nenhuma integracao real
/// de transportador nesta rodada -- carrier/trackingCode sao texto livre.
enum ReturnShipmentStatus {
  PENDING
  POSTED
  RECEIVED
  LOST

  @@schema("orders")
}

model Order {
  id            String      @id @default(uuid()) @db.Uuid
  /// Referência solta (UUID) a identity.usuarios — sem FK cross-schema.
  /// Resolvido por SessionAuthGuard (rede, identity-service), nunca entrada
  /// bruta de cliente.
  customerId    String      @map("cliente_id") @db.Uuid
  orderNumber   String      @unique @map("numero_pedido")
  status        OrderStatus @default(PENDING_PAYMENT)
  /// Money CHECKs: each money column >= 0. No formula tying total to subtotal+shipping-discount
  /// (future taxes/credits/adjustments must remain possible).
  subtotalCents Int         @map("subtotal_centavos")
  /// v1 não calcula frete — sempre 0. Ver README.md.
  shippingCents Int         @default(0) @map("frete_centavos")
  discountCents Int         @default(0) @map("desconto_centavos")
  totalCents    Int         @map("total_centavos")
  createdAt     DateTime    @default(now()) @map("criado_em")
  updatedAt     DateTime    @updatedAt @map("atualizado_em")

  shippingAddress        OrderShippingAddress?
  sellerOrders           SellerOrder[]
  paymentTransactions    PaymentTransaction[]
  /// Pos-venda (fundacao) -- ver model Claim mais abaixo.
  claims                 Claim[]
  /// F2.1 -- chave de idempotência que criou este pedido (quando enviada).
  checkoutIdempotencyKey CheckoutIdempotencyKey?

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@map("pedidos")
  @@schema("orders")
}

/// Snapshot of the delivery address at checkout time. Independent of any address book.
model OrderShippingAddress {
  id           String  @id @default(uuid()) @db.Uuid
  orderId      String  @unique @map("pedido_id") @db.Uuid
  recipient    String  @map("destinatario")
  street       String  @map("logradouro")
  number       String  @map("numero")
  complement   String? @map("complemento")
  neighborhood String  @map("bairro")
  city         String  @map("cidade")
  state        String  @map("estado")
  postalCode   String  @map("cep")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("enderecos_entrega_pedido")
  @@schema("orders")
}

model SellerOrder {
  id              String            @id @default(uuid()) @db.Uuid
  orderId         String            @map("pedido_id") @db.Uuid
  /// Referência solta (UUID) a sellers.vendedores — sem FK cross-schema.
  /// Resolvido por CatalogServiceClient.resolveProductVariants (rede,
  /// catalog-service, que por sua vez é o dono autoritativo de
  /// Product.sellerId) — nunca entrada bruta de cliente.
  sellerId        String            @map("vendedor_id") @db.Uuid
  status          SellerOrderStatus @default(PENDING)
  /// Money CHECKs: each column >= 0. No rigid sellerNet = subtotal + shipping - commission.
  subtotalCents   Int               @map("subtotal_centavos")
  /// v1 não calcula frete nem comissão — sempre 0. Ver README.md.
  shippingCents   Int               @default(0) @map("frete_centavos")
  commissionCents Int               @default(0) @map("comissao_centavos")
  sellerNetCents  Int               @default(0) @map("liquido_vendedor_centavos")
  createdAt       DateTime          @default(now()) @map("criado_em")
  updatedAt       DateTime          @updatedAt @map("atualizado_em")

  order  Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items  OrderItem[]
  /// Pos-venda (fundacao) -- ver model Claim mais abaixo.
  claims Claim[]

  @@unique([orderId, sellerId])
  @@index([orderId])
  @@index([sellerId])
  @@index([status])
  @@map("pedidos_vendedor")
  @@schema("orders")
}

model OrderItem {
  id             String @id @default(uuid()) @db.Uuid
  sellerOrderId  String @map("pedido_vendedor_id") @db.Uuid
  /// Referências soltas (UUID) a catalog.produtos / catalog.variantes_produto
  /// — sem FK cross-schema. Ambas vêm de
  /// CatalogServiceClient.resolveProductVariants, nunca de entrada bruta de
  /// cliente (o cliente manda productId/variantId candidatos; o que fica
  /// gravado aqui é sempre o que catalog-service confirmou).
  productId      String @map("produto_id") @db.Uuid
  variantId      String @map("variante_id") @db.Uuid
  productTitle   String @map("titulo_produto")
  sku            String
  /// Snapshot CHECKs: quantidade > 0, money >= 0. No formula lineTotal = qty * unitPrice
  /// (enforced in application code at write time; not re-derived by the database).
  quantity       Int    @map("quantidade")
  unitPriceCents Int    @map("preco_unitario_centavos")
  lineTotalCents Int    @map("total_linha_centavos")

  sellerOrder   SellerOrder @relation(fields: [sellerOrderId], references: [id], onDelete: Cascade)
  review        Review?
  returnRequest Return?
  /// Pos-venda (fundacao) -- um item pode gerar mais de uma Claim ao
  /// longo do tempo (diferente de Review/Return, que sao 1:1).
  claims        Claim[]

  @@index([sellerOrderId])
  @@index([productId])
  @@map("itens_pedido")
  @@schema("orders")
}

/// Charge attempts only (PENDING / APPROVED / FAILED / CANCELLED). Never store PAN/CVV.
/// amountCents CHECK: valor_centavos > 0. Refunds must not use negative amounts; add a type
/// discriminator first (this model has no CHARGE vs REFUND).
/// Idempotency: @@unique([provider, providerRef]). PostgreSQL treats NULL providerRef as distinct,
/// so many (provider, NULL) rows are allowed; a second (provider, same-ref) is rejected.
/// Empty/whitespace-only provider and providerRef are forbidden (CHECK + BTRIM). Values are not
/// trimmed in the database; the application/gateway normalizes provider.
/// If providerRef is set, provider is required (CHECK).
///
/// v1 only ever writes provider = "mock" (MockPaymentGatewayAdapter — see
/// modules/payments). The column stays provider-agnostic on purpose so a
/// real gateway adapter can be swapped in later without a schema change.
model PaymentTransaction {
  id          String                   @id @default(uuid()) @db.Uuid
  orderId     String                   @map("pedido_id") @db.Uuid
  status      PaymentTransactionStatus @default(PENDING)
  amountCents Int                      @map("valor_centavos")
  provider    String?                  @map("provedor")
  providerRef String?                  @map("referencia_provedor")
  createdAt   DateTime                 @default(now()) @map("criado_em")
  updatedAt   DateTime                 @updatedAt @map("atualizado_em")

  order Order @relation(fields: [orderId], references: [id])

  @@unique([provider, providerRef], map: "transacoes_pagamento_provedor_referencia_provedor_key")
  @@index([orderId])
  @@index([status])
  @@map("transacoes_pagamento")
  @@schema("orders")
}

/// Fase B do roadmap pos-entrega (ver roadmap-mercado-livre.md, secao 6) --
/// avaliacao e reputacao. Uma avaliacao por item comprado, garantido pelo
/// @unique em orderItemId no proprio banco, nao so na aplicacao -- mesmo
/// estilo de integridade que PaymentTransaction.@@unique([provider,
/// providerRef]) acima. customerId/sellerId/productId sao snapshot no
/// momento da avaliacao, nunca FK cross-schema -- mesmo raciocinio de
/// OrderItem.productTitle/sku (linhas acima): sellerId vem de
/// SellerOrder.sellerId, productId vem de OrderItem.productId, ambos ja
/// resolvidos e validados por CatalogServiceClient no checkout, nunca
/// entrada bruta de cliente nesta escrita.
/// rating CHECK (1..5): adicionado a mao na migration em SQL cru, mesmo
/// padrao de todo CHECK numerico deste schema -- ver README.md.
model Review {
  id          String   @id @default(uuid()) @db.Uuid
  orderItemId String   @unique @map("item_pedido_id") @db.Uuid
  /// Referencia solta (UUID) a identity.usuarios -- quem comprou. Resolvido
  /// da sessao (SessionAuthGuard), nunca do corpo da requisicao.
  customerId  String   @map("cliente_id") @db.Uuid
  /// Snapshot de SellerOrder.sellerId no momento da avaliacao -- alimenta o
  /// agregado de reputacao do vendedor sem chamada cross-service.
  sellerId    String   @map("vendedor_id") @db.Uuid
  /// Snapshot de OrderItem.productId -- alimenta o agregado de nota do
  /// produto sem chamada cross-service.
  productId   String   @map("produto_id") @db.Uuid
  rating      Int      @map("nota")
  comment     String?  @map("comentario")
  createdAt   DateTime @default(now()) @map("criado_em")

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([sellerId])
  @@map("avaliacoes")
  @@schema("orders")
}

/// Cupons de desconto -- pedido de Arthur (urgente, ver
/// status-migracao-microservicos.md). Vive em orders-service, não em
/// sellers-service ou catalog-service, porque: (1) não tem sellerId --
/// mock confirma cupom é sempre marketplace-wide, nunca por loja
/// (ver src/features/admin/domain/types.ts no frontend, sem esse campo);
/// (2) Order já tinha uma coluna discountCents zerada à espera disso desde
/// a extração original do monólito ("v1 não calcula frete nem descontos --
/// sempre 0", orders.service.ts) -- este model é o que finalmente
/// preenche esse buraco, no mesmo serviço que já possui a coluna.
///
/// status (ativo/agendado/expirado/desativado, como no mock) NÃO é uma
/// coluna própria -- é derivado em runtime de enabled + comeca_em/termina_em
/// (CouponsService.deriveStatus), pelo mesmo motivo de Review não guardar
/// nota agregada: evita job de background pra manter um campo sincronizado
/// que dá pra calcular na leitura.
///
/// usageCount/totalDiscountCents são contadores atômicos incrementados no
/// checkout (mesma transação que cria o Order -- ver insertOrder em
/// orders.service.ts), não uma tabela de resgate à parte: mantém a
/// migration no menor escopo possível, mesmo raciocínio que já vinha sendo
/// aplicado nesta sessão (Admin: Clientes sem AuditLog). totalDiscountCents
/// substitui o "revenueCents" do mock -- aquele nome media receita
/// atribuída ao cupom, que não é computável sem juntar todo pedido que usou
/// o cupom; o que dá pra somar honestamente aqui é o desconto que o cupom
/// efetivamente concedeu.
///
/// channel do mock (all/site/app) foi removido -- não existe app do
/// marketplace, só o storefront web, então "canal" não distingue nada de
/// real hoje. Mesmo princípio de remover campo sem contrapartida real já
/// usado em CustomersView/SellersView.
model Coupon {
  id                 String             @id @default(uuid()) @db.Uuid
  code               String             @unique @map("codigo")
  name               String             @map("nome")
  discountType       CouponDiscountType @map("tipo_desconto")
  /// Percentual (1-100) ou centavos (>0), a depender de discountType --
  /// CHECKs na migration, mesmo padrão de Review.rating.
  discountValue      Int                @map("valor_desconto")
  /// Liga/desliga manual do admin (botão "Ativar"/"Desativar" no mock).
  /// Independente de comeca_em/termina_em -- um cupom pode estar dentro da
  /// janela de vigência e ainda assim desativado.
  enabled            Boolean            @default(true) @map("habilitado")
  startsAt           DateTime           @map("comeca_em")
  endsAt             DateTime           @map("termina_em")
  usageCount         Int                @default(0) @map("usos")
  totalDiscountCents Int                @default(0) @map("desconto_total_centavos")
  createdAt          DateTime           @default(now()) @map("criado_em")
  updatedAt          DateTime           @updatedAt @map("atualizado_em")

  @@index([enabled])
  @@map("cupons")
  @@schema("orders")
}

/// Devoluções -- pedido de Arthur ("vamos seguir em frente"), Fase E do
/// roadmap pós-entrega adiantada (ver roadmap-mercado-livre.md, seção 3:
/// "proteção ao comprador... o painel admin já tem a estrutura de
/// moderação... o admin como mediador"). Vive em orders-service, mesmo
/// raciocínio de Review: este serviço já é dono do OrderItem, e "só quem
/// comprou pode pedir devolução, uma vez por item" só é barato de garantir
/// referenciando o item de pedido diretamente, com @unique no próprio
/// banco -- não só na aplicação.
///
/// Elegibilidade (mesma de Review, mesmo motivo): SellerOrder com status
/// DELIVERED -- corrigido em 29/09 em returns.service.ts (este comentário
/// aqui no schema ficou desatualizado até agora citando CONFIRMED; ver
/// claude/plano-pos-venda-reclamacoes-devolucoes-disputas.md, item 4.7).
///
/// status segue sendo criado como REQUESTED e decidido via decide()
/// (APPROVED/REJECTED) -- de propósito SEM reembolso automático:
/// reembolsar de verdade exigiria (a) um discriminador CHARGE/REFUND em
/// PaymentTransaction, que hoje só modela cobranças (ver comentário no
/// model PaymentTransaction acima: "Refunds must not use negative
/// amounts; add a type discriminator first"), e (b) repor estoque de
/// volta em catalog-service, que hoje não tem nenhum método pra isso
/// (reserve/release/commitReservedStock cobrem reserva e venda, não
/// devolução pós-venda). O enum ganhou valores NOVOS nesta rodada
/// (fundação do pós-venda -- ver plano acima) para o ciclo de logística
/// reversa completo (AWAITING_SHIPMENT/SHIPPED/RECEIVED/UNDER_REVIEW/
/// COMPLETED/CONTESTED/CANCELLED), de forma puramente aditiva -- nenhum
/// valor existente foi removido ou renomeado, e decide()/o fluxo atual
/// continuam funcionando sem mudança. As transições que usam os valores
/// novos (ship/receive/review/contest) ficam para a próxima rodada (P1);
/// esta é só a fundação de schema. O admin aprovando continua registrado
/// como decisão real; o reembolso em si continua processado por fora do
/// sistema por enquanto (nota explícita na tela, mesmo espírito de
/// honestidade já aplicado ao resto do projeto).
model Return {
  id                     String       @id @default(uuid()) @db.Uuid
  orderItemId            String       @unique @map("item_pedido_id") @db.Uuid
  /// Referência solta (UUID) a identity.usuarios -- quem comprou. Resolvido
  /// da sessão (SessionAuthGuard), nunca do corpo da requisição.
  customerId             String       @map("cliente_id") @db.Uuid
  /// Snapshot de SellerOrder.sellerId no momento do pedido de devolução.
  sellerId               String       @map("vendedor_id") @db.Uuid
  /// Snapshot de OrderItem.productId.
  productId              String       @map("produto_id") @db.Uuid
  reason                 String       @map("motivo")
  description            String?      @map("descricao")
  status                 ReturnStatus @default(REQUESTED)
  /// Condição do item constatada na inspeção (passo UNDER_REVIEW,
  /// fundação -- preenchimento real fica para P1). reviewedByUserId é
  /// referência solta (identity.usuarios) a quem inspecionou (vendedor ou
  /// admin), nunca o próprio cliente.
  receivedConditionNotes String?      @map("notas_condicao_recebimento")
  reviewedByUserId       String?      @map("revisado_por_usuario_id") @db.Uuid
  createdAt              DateTime     @default(now()) @map("criado_em")
  updatedAt              DateTime     @updatedAt @map("atualizado_em")

  orderItem   OrderItem        @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  /// Pos-venda (fundação) -- a Claim que gerou esta devolução, se houver.
  /// A FK mora em Claim.returnId (não aqui), pra não duplicar o mesmo
  /// relacionamento nos dois lados -- ver model Claim.
  originClaim Claim?
  /// Pos-venda (fundação) -- 1:N de propósito, ver enum ReturnShipmentStatus.
  shipments   ReturnShipment[]
  /// Pos-venda (fundação) -- preenchido só se esta devolução for contestada
  /// e escalar a mediação formal. A FK mora em Dispute.returnId -- ver
  /// model Dispute.
  dispute     Dispute?

  @@index([customerId])
  @@index([sellerId])
  @@index([status])
  @@map("devolucoes")
  @@schema("orders")
}

/// Reclamação (ticket de pós-venda) -- fundação da Fase E, primeira peça
/// que não existia em NENHUMA forma antes desta rodada (ver
/// claude/plano-pos-venda-reclamacoes-devolucoes-disputas.md, item 5).
/// Mais genérica que Return: nem toda reclamação é sobre devolver
/// mercadoria ("item nunca chegou", "cobrança duplicada" também cabem
/// aqui).
///
/// orderId/sellerOrderId/orderItemId são FK reais -- vivem no MESMO
/// schema orders, diferente de customerId/sellerId (snapshot solto,
/// identity-service/sellers-service, mesmo padrão de Return/Review
/// acima). Denormalizados (orderId/sellerOrderId são alcançáveis via
/// orderItem.sellerOrder) pelo mesmo motivo de Return.sellerId/productId
/// já serem snapshot de OrderItem/SellerOrder: consulta direta sem join.
///
/// orderItemId NÃO é @unique (diferente de Review/Return) -- um mesmo
/// item pode gerar mais de uma reclamação ao longo do tempo (ex.:
/// reaberta depois de CLOSED). returnId é o link opcional "esta
/// reclamação gerou uma devolução" -- a FK mora aqui, não em Return, pra
/// não duplicar o mesmo relacionamento nos dois lados (mesmo raciocínio
/// de Dispute.claimId/Dispute.returnId abaixo). O link inverso "esta
/// reclamação escalou pra disputa formal" mora em Dispute.claimId, não
/// aqui, pelo mesmo motivo -- ver model Dispute.
model Claim {
  id            String      @id @default(uuid()) @db.Uuid
  orderId       String      @map("pedido_id") @db.Uuid
  sellerOrderId String      @map("pedido_vendedor_id") @db.Uuid
  orderItemId   String      @map("item_pedido_id") @db.Uuid
  /// Referência solta (UUID) a identity.usuarios -- sem FK cross-schema.
  customerId    String      @map("cliente_id") @db.Uuid
  /// Snapshot de SellerOrder.sellerId no momento da reclamação.
  sellerId      String      @map("vendedor_id") @db.Uuid
  reason        String      @map("motivo")
  description   String?     @map("descricao")
  status        ClaimStatus @default(OPEN)
  /// Link opcional: esta reclamação gerou uma devolução formal.
  returnId      String?     @unique @map("devolucao_id") @db.Uuid
  createdAt     DateTime    @default(now()) @map("criado_em")
  updatedAt     DateTime    @updatedAt @map("atualizado_em")
  resolvedAt    DateTime?   @map("resolvido_em")

  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sellerOrder SellerOrder     @relation(fields: [sellerOrderId], references: [id], onDelete: Cascade)
  orderItem   OrderItem       @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  return      Return?         @relation(fields: [returnId], references: [id])
  dispute     Dispute?
  messages    ClaimMessage[]
  evidence    ClaimEvidence[]

  @@index([customerId])
  @@index([sellerId])
  @@index([orderId])
  @@index([sellerOrderId])
  @@index([orderItemId])
  @@index([status])
  @@map("reclamacoes")
  @@schema("orders")
}

/// Mensagem na conversa de uma Claim -- cliente, vendedor e admin no mesmo
/// fio, nunca string livre pra papel (ClaimAuthorRole -- mesmo motivo de
/// qualquer outro enum deste schema). authorUserId é snapshot solto
/// (identity.usuarios, admin inclusive -- admin também é um usuário em
/// identity-service). Nunca senha, token ou segredo aqui -- só o texto da
/// mensagem.
model ClaimMessage {
  id           String          @id @default(uuid()) @db.Uuid
  claimId      String          @map("reclamacao_id") @db.Uuid
  authorUserId String          @map("autor_usuario_id") @db.Uuid
  authorRole   ClaimAuthorRole @map("autor_papel")
  body         String          @map("mensagem")
  createdAt    DateTime        @default(now()) @map("criado_em")

  claim Claim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([claimId])
  @@map("reclamacao_mensagens")
  @@schema("orders")
}

/// Metadados de um arquivo anexado a uma Claim -- NUNCA o arquivo em si.
/// storageKey é só a chave no bucket (Supabase Storage, infraestrutura
/// ainda NÃO implementada nesta rodada -- ver pedido original, item 7);
/// nunca guardamos signed URL (expira, não deveria persistir) nem
/// binário/base64 no Postgres. uploadedByRole replica o mesmo raciocínio
/// de ClaimMessage.authorRole -- adição não pedida explicitamente na
/// lista original de campos, mas direta e simétrica; sinalizada no
/// relatório desta rodada como decisão própria.
model ClaimEvidence {
  id               String          @id @default(uuid()) @db.Uuid
  claimId          String          @map("reclamacao_id") @db.Uuid
  uploadedByUserId String          @map("enviado_por_usuario_id") @db.Uuid
  uploadedByRole   ClaimAuthorRole @map("enviado_por_papel")
  storageKey       String          @map("chave_armazenamento")
  fileName         String          @map("nome_arquivo")
  mimeType         String          @map("tipo_mime")
  sizeBytes        Int             @map("tamanho_bytes")
  createdAt        DateTime        @default(now()) @map("criado_em")

  claim Claim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([claimId])
  @@map("reclamacao_evidencias")
  @@schema("orders")
}

/// Uma tentativa de envio físico de volta ao vendedor -- separada de
/// Return de propósito (1:N, nunca @@unique em returnId): uma tentativa
/// perdida pelo transportador gera uma SEGUNDA linha aqui, não uma
/// atualização confusa da primeira (ver enum ReturnShipmentStatus).
/// Nenhuma integração real de transportador nesta rodada -- carrier/
/// trackingCode são texto livre informado pelo cliente, não uma consulta
/// de rastreio de verdade.
model ReturnShipment {
  id           String               @id @default(uuid()) @db.Uuid
  returnId     String               @map("devolucao_id") @db.Uuid
  carrier      String?              @map("transportadora")
  trackingCode String?              @map("codigo_rastreio")
  status       ReturnShipmentStatus @default(PENDING)
  postedAt     DateTime?            @map("postado_em")
  receivedAt   DateTime?            @map("recebido_em")
  createdAt    DateTime             @default(now()) @map("criado_em")
  updatedAt    DateTime             @updatedAt @map("atualizado_em")

  returnRequest Return @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@index([returnId])
  @@index([status])
  @@map("devolucao_envios")
  @@schema("orders")
}

/// Mediação formal -- só existe quando há desacordo real, nasce de uma
/// Claim OU de uma Return contestada, nunca das duas ao mesmo tempo
/// (CHECK manual na migration, mesmo padrão de todo CHECK deste schema:
/// exatamente um de claimId/returnId precisa estar preenchido). outcome
/// fica deliberadamente separado de status (DisputeStatus = fase,
/// outcome = quem ganhou) e nullable enquanto a disputa está aberta -- o
/// outcome "oficial" mora aqui (resumo rápido sem precisar olhar
/// histórico), mas cada decisão individual é preservada em
/// DisputeDecision (1:N, nunca sobrescrita) para auditoria.
///
/// claim/return usam onDelete: Restrict, NUNCA SetNull -- achado na
/// revisão contra o SQL oficial do Prisma: SetNull deixaria claimId=NULL
/// E returnId=NULL ao apagar a origem, violando o próprio
/// disputas_origem_unica_check (exige exatamente uma origem). Restrict
/// também preserva histórico/auditoria -- a origem de uma disputa
/// existente nunca pode ser apagada. Claim.returnId (não aqui) continua
/// SetNull de propósito -- não há CHECK em Claim exigindo returnId.
model Dispute {
  id         String          @id @default(uuid()) @db.Uuid
  claimId    String?         @unique @map("reclamacao_id") @db.Uuid
  returnId   String?         @unique @map("devolucao_id") @db.Uuid
  status     DisputeStatus   @default(OPEN)
  outcome    DisputeOutcome?
  openedAt   DateTime        @default(now()) @map("aberta_em")
  resolvedAt DateTime?       @map("resolvida_em")
  closedAt   DateTime?       @map("fechada_em")

  claim     Claim?            @relation(fields: [claimId], references: [id], onDelete: Restrict)
  return    Return?           @relation(fields: [returnId], references: [id], onDelete: Restrict)
  decisions DisputeDecision[]

  @@index([status])
  @@map("disputas")
  @@schema("orders")
}

/// Histórico de decisões administrativas de uma Dispute -- 1:N de
/// propósito (NÃO @@unique em disputeId): "não sobrescrever decisões
/// antigas se futuramente precisarmos de histórico" (pedido original,
/// item 11). A decisão "atual" mora em Dispute.outcome/status; esta
/// tabela é o log completo de quem decidiu o quê e quando, inclusive se
/// uma decisão futura for revista.
model DisputeDecision {
  id              String         @id @default(uuid()) @db.Uuid
  disputeId       String         @map("disputa_id") @db.Uuid
  /// Referência solta (UUID) a identity.usuarios -- sem FK cross-schema.
  decidedByUserId String         @map("decidido_por_usuario_id") @db.Uuid
  outcome         DisputeOutcome
  reason          String         @map("motivo")
  createdAt       DateTime       @default(now()) @map("criado_em")

  dispute Dispute @relation(fields: [disputeId], references: [id], onDelete: Restrict)

  @@index([disputeId])
  @@map("decisoes_disputa")
  @@schema("orders")
}

/// Lista de desejos do cliente -- produto <-> cliente, sem relação com
/// pedido nenhum (diferente de Review/Coupon/Return acima, todos nascidos
/// de uma compra). Vive aqui mesmo assim, não em identity-service: segue a
/// mesma decisão já tomada na prática para avaliações e cupons (a análise
/// de arquitetura original previa "customers" crescendo dentro de
/// identity-service, mas o crescimento real -- avaliações, cupons -- caiu
/// todo em orders-service; endereços continua a única exceção genuína, por
/// ser puramente identidade/PII, sem nenhum link a produto).
model Favorite {
  id         String   @id @default(uuid()) @db.Uuid
  /// Referência solta (UUID) a identity.usuarios. Resolvido da sessão
  /// (SessionAuthGuard), nunca do corpo da requisição -- mesmo padrão de
  /// Review.customerId acima.
  customerId String   @map("cliente_id") @db.Uuid
  /// Referência solta (UUID) a catalog.produtos -- sem FK cross-schema,
  /// mesmo padrão de Review.productId. Ao contrário de Review (snapshot do
  /// produto no momento da compra), aqui NÃO guardamos nome/imagem/preço:
  /// a lista de favoritos deve refletir o produto como ele está agora, não
  /// como estava quando foi favoritado -- o frontend resolve cada item via
  /// GET /public/products/:id (catalog-service) na hora de exibir.
  productId  String   @map("produto_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("criado_em")

  @@unique([customerId, productId])
  @@index([customerId])
  @@map("favoritos")
  @@schema("orders")
}

// ---------------------------------------------------------------------------
// F2.1 -- Idempotência do checkout
// ---------------------------------------------------------------------------

enum CheckoutIdempotencyStatus {
  IN_PROGRESS
  COMPLETED
  FAILED

  @@schema("orders")
}

/// Uma linha por (cliente, chave) de POST /orders/checkout com o header
/// Idempotency-Key. A unicidade (cliente_id, chave) no Postgres é a garantia
/// atômica entre requisições concorrentes e entre instâncias do serviço
/// (INSERT ... ON CONFLICT DO NOTHING via createMany skipDuplicates).
///
/// - IN_PROGRESS sem pedido: posse temporária até `lockedUntil`; vencida,
///   um retry pode retomar (troca de lockToken por UPDATE condicional).
/// - IN_PROGRESS com pedido: execução interrompida depois de o pedido
///   existir; nunca é reexecutada, o retry recebe o pedido existente.
/// - COMPLETED: o retry recebe o pedido (estado atual).
/// - FAILED: erro ocorrido depois de o pedido existir (reserva ou
///   pagamento); o retry recebe o mesmo status/corpo de erro.
/// requestHash = SHA-256 do payload canônico; mesma chave com outro
/// payload é recusada (422). CHECKs extras na migration.
model CheckoutIdempotencyKey {
  id             String                    @id @default(uuid()) @db.Uuid
  /// Referência solta (UUID) a identity.usuarios -- sem FK cross-schema.
  customerId     String                    @map("cliente_id") @db.Uuid
  key            String                    @map("chave") @db.VarChar(128)
  requestHash    String                    @map("hash_requisicao") @db.Char(64)
  status         CheckoutIdempotencyStatus @default(IN_PROGRESS)
  lockToken      String                    @map("token_execucao") @db.Uuid
  lockedUntil    DateTime                  @map("bloqueada_ate")
  orderId        String?                   @unique @map("pedido_id") @db.Uuid
  responseStatus Int?                      @map("status_resposta")
  responseBody   Json?                     @map("corpo_resposta")
  createdAt      DateTime                  @default(now()) @map("criado_em")
  updatedAt      DateTime                  @updatedAt @map("atualizado_em")
  completedAt    DateTime?                 @map("concluida_em")

  order Order? @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([customerId, key])
  @@map("chaves_idempotencia_checkout")
  @@schema("orders")
}
